
# ==========================================
# PostgreSQL
# ==========================================

POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me

# Puerto externo de PostgreSQL (LAN)
POSTGRES_EXTERNAL_PORT=5432


# ==========================================
# Aplicación
# ==========================================

MAIN_PORT=86

DATABASE_URL=postgres://app_user:change_me@postgres:5432/app_db

# JWT
JWT_SECRET=replace_with_a_long_random_secret

# Administrador inicial
ADMIN_USERNAME=admin

# Hash bcrypt de la contraseña del administrador
# cambiar la contraseña una ves inicie secion por primera vez
# example123
ADMIN_HASH='$2b$12$quoqdrPk5LD9qV5wVzjuzOEYJMaPmy8wEGhFoos0yomh7d9OdKSBS'


# ==========================================
# Entorno
# ==========================================

# production o development
NODE_ENV=development


# ==========================================
# Backups automáticos
# ==========================================

# Intervalo entre backups en segundos
# 86400 = 24 horas
BACKUP_INTERVAL=86400
